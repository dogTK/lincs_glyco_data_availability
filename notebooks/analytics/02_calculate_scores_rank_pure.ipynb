    "\n",
    "plt.show()\n",
    "print(f'保存完了: fig_top20_frequent_genes.svg/png/pdf')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# signed rankでのTop/Bottom抽出（補助分析）\n",
    "def extract_signed_topN(\n",
    "    df_scores: pd.DataFrame,\n",
    "    top_n: int = 10\n",
    ") -> Tuple[pd.DataFrame, pd.DataFrame]:\n",
    "    \"\"\"\n",
    "    signed rankで上方（score大）と下方（score小）のTopN遺伝子を抽出\n",
    "    \"\"\"\n",
    "    results_up = []\n",
    "    results_down = []\n",
    "    \n",
    "    for drug in df_scores['drug'].unique():\n",
    "        drug_data = df_scores[df_scores['drug'] == drug].copy()\n",
    "        \n",
    "        # 上方（score大=z-scoreが高い傾向）\n",
    "        top_up = drug_data.nlargest(top_n, 'score').reset_index(drop=True)\n",
    "        top_up['rank_within_drug'] = range(1, len(top_up) + 1)\n",
    "        top_up['direction'] = 'up'\n",
    "        results_up.append(top_up)\n",
    "        \n",
    "        # 下方（score小=z-scoreが低い傾向）\n",
    "        top_down = drug_data.nsmallest(top_n, 'score').reset_index(drop=True)\n",
    "        top_down['rank_within_drug'] = range(1, len(top_down) + 1)\n",
    "        top_down['direction'] = 'down'\n",
    "        results_down.append(top_down)\n",
    "    \n",
    "    df_up = pd.concat(results_up, ignore_index=True)\n",
    "    df_down = pd.concat(results_down, ignore_index=True)\n",
    "    \n",
    "    return df_up, df_down\n",
    "\n",
    "df_topN_up, df_topN_down = extract_signed_topN(df_drug_scores_signed, top_n=10)\n",
    "\n",
    "print(f\"【Signed rank 補助分析】\")\n",
    "print(f\"  上方制御候補: {len(df_topN_up):,}レコード\")\n",
    "print(f\"  下方制御候補: {len(df_topN_down):,}レコード\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": "## 4. Visualization of Rank Calculation Results\n\nVisualize gene response characteristics (Strength, Variability, Directionality) for each gene."
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def compute_gene_metrics(df_scores: pd.DataFrame) -> pd.DataFrame:\n",
    "    \"\"\"\n",
    "    遺伝子ごとの情報量メトリクスを計算\n",
    "    \n",
    "    Returns:\n",
    "    --------\n",
    "    pd.DataFrame with columns:\n",
    "        - gene: 遺伝子名\n",
    "        - strength: 応答強度（中央値rankの逆数、低rank=強応答）\n",
    "        - variability: 薬剤間のばらつき（IQR）\n",
    "        - responsiveness: 1 / mean_rank（応答しやすさ）\n",
    "    \"\"\"\n",
    "    metrics = []\n",
    "    \n",
    "    for gene in df_scores['gene'].unique():\n",
    "        gene_data = df_scores[df_scores['gene'] == gene]['score']\n",
    "        \n",
    "        median_rank = gene_data.median()\n",
    "        mean_rank = gene_data.mean()\n",
    "        iqr = gene_data.quantile(0.75) - gene_data.quantile(0.25)\n",
    "        \n",
    "        # Strength: 低いrankほど強い応答 → 逆数で表現\n",
    "        strength = 1 / median_rank if median_rank > 0 else 0\n",
    "        \n",
    "        # Responsiveness: 1 / mean_rank\n",
    "        responsiveness = 1 / mean_rank if mean_rank > 0 else 0\n",
    "        \n",
    "        metrics.append({\n",
    "            'gene': gene,\n",
    "            'median_rank': median_rank,\n",
    "            'mean_rank': mean_rank,\n",
    "            'iqr': iqr,\n",
    "            'strength': strength,\n",
    "            'variability': iqr,\n",
    "            'responsiveness': responsiveness\n",
    "        })\n",
    "    \n",
    "    return pd.DataFrame(metrics)\n",
    "\n",
    "# 遺伝子メトリクス計算\n",
    "df_gene_metrics = compute_gene_metrics(df_drug_scores_mag)\n",
    "\n",
    "# 頻度情報をマージ\n",
    "df_gene_metrics = df_gene_metrics.merge(df_gene_freq, on='gene', how='left')\n",
    "df_gene_metrics['freq'] = df_gene_metrics['freq'].fillna(0).astype(int)\n",
    "df_gene_metrics['freq_percent'] = df_gene_metrics['freq_percent'].fillna(0)\n",
    "\n",
    "print(f\"遺伝子メトリクス: {len(df_gene_metrics)}遺伝子\")\n",
    "print(df_gene_metrics.head(10))"
