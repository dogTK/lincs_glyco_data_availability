 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": "# Pure Rank Aggregation for Drug-Responsive Glycogene Extraction\n\nDiscontinued the conventional \"abs_mean / SE correction\" approach, switching to median aggregation of within-sample ranks.\n\n## Algorithm Overview\n1. For each sample s, convert glycogene z-scores to ranks\n   - **(A) magnitude rank**: Rank by |z| descending (larger |z| = smaller rank for TopN extraction)\n   - **(B) signed rank**: Rank by z ascending (lower z = smaller rank for directionality)\n2. For each drug d, aggregate ranks by median across all samples\n3. Extract TopN genes per drug (smaller magnitude rank = stronger response)\n4. Count frequency across all drugs to identify frequent genes\n5. Robustness check (TopN, min_samples sensitivity)\n6. GlycoEnzOnto enrichment analysis\n7. Generate Figure 1 equivalent"
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": "import pandas as pd\nimport numpy as np\nimport matplotlib.pyplot as plt\nfrom pathlib import Path\nimport sys\nimport os\nimport logging\nfrom typing import Dict, List, Optional, Tuple\nfrom cryptography.hazmat.backends import default_backend\nfrom cryptography.hazmat.primitives import serialization\nfrom snowflake.connector import connect\nfrom scipy.stats import fisher_exact\nfrom statsmodels.stats.multitest import multipletests\nimport warnings\nwarnings.filterwarnings('ignore')\n\n# Logging configuration\nlogging.basicConfig(level=logging.INFO, format='%(asctime)s - %(levelname)s - %(message)s')\nlogger = logging.getLogger(__name__)\n\n# Add project root to path\nproject_root = Path.cwd().parent.parent\nsys.path.insert(0, str(project_root))\nsys.path.insert(0, str(project_root / 'src'))\n\nfrom utils.pathway_abbreviations import abbreviate_pathway\n\n# Results directory\nresults_dir = project_root / 'notebooks' / 'results' / 'rank_pure'\nresults_dir.mkdir(parents=True, exist_ok=True)\n\n# Figure directory\nfigure_dir = project_root / 'notebooks' / 'results' / 'figure1_rank_pure'\nfigure_dir.mkdir(parents=True, exist_ok=True)\n\nprint(f'Project root: {project_root}')\nprint(f'Results directory: {results_dir}')\nprint(f'Figure directory: {figure_dir}')"
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": "## 1. Snowflake Connection and Data Retrieval"
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": "def load_private_key() -> bytes:\n    \"\"\"Load private key (DER format)\"\"\"\n    key_path = os.path.expanduser('os.environ.get("SNOWFLAKE_PRIVATE_KEY_PATH", "~/.ssh/snowflake_rsa_key.pem")')\n    with open(key_path, \"rb\") as key_file:\n        private_key = serialization.load_pem_private_key(\n            key_file.read(),\n            password=None,\n            backend=default_backend()\n        )\n    private_key_der = private_key.private_bytes(\n        encoding=serialization.Encoding.DER,\n        format=serialization.PrivateFormat.PKCS8,\n        encryption_algorithm=serialization.NoEncryption()\n    )\n    return private_key_der\n\n\ndef connect_to_snowflake():\n    \"\"\"Connect to Snowflake\"\"\"\n    try:\n        conn = connect(\n            user=os.environ.get(\"SNOWFLAKE_USER\"),\n            account=os.environ.get(\"SNOWFLAKE_ACCOUNT\"),\n            private_key=load_private_key(),\n            warehouse=\"BIOINFORMATICS_XS\",\n            database=\"BIOINFORMATICS\",\n            schema=\"LINCS\",\n            role=\"ACCOUNTADMIN\",\n        )\n        logger.info(\"Snowflake connection successful\")\n        return conn\n    except Exception as e:\n        logger.error(f\"Snowflake connection error: {e}\")\n        raise\n\nprint(\"Snowflake connection functions defined\")"
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": "# Load liver cancer cell line list\nliver_cells_path = project_root / \"notebooks\" / \"results\" / \"liver_cell_lines_list.csv\"\ndf_liver_list = pd.read_csv(liver_cells_path)\ncell_lines = df_liver_list['CELL_LINE_NAME'].tolist()\n\nprint(f\"Loaded liver cancer cell line list: {len(cell_lines)} types\")\nprint(f\"Cell lines: {', '.join(cell_lines)}\")\n\n# Connect to Snowflake\nconn = connect_to_snowflake()"
  },
