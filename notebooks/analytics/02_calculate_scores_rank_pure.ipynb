   "outputs": [],
   "source": "# Retrieve liver cancer cell line data\ngene_columns = ', '.join([f'\"{gene}\"' for gene in glyco_genes])\ncell_lines_str = \"', '\".join(cell_lines)\n\nquery = f\"\"\"\nSELECT \n    \"sample_id\",\n    \"canonical_smiles\",\n    \"inchi_key\",\n    \"pertname\",\n    \"pertid\",\n    \"cell\",\n    \"dose\",\n    \"timepoint\",\n    {gene_columns}\nFROM BIOINFORMATICS.LINCS.GLYCO_GENES_WIDE\nWHERE \"cell\" IN ('{cell_lines_str}')\n\"\"\"\n\nprint(\"Executing query...\")\ndf = pd.read_sql(query, conn)\nprint(f\"Data retrieval complete: {len(df):,} records\")\nprint(f\"Number of compounds: {df['pertname'].nunique()}\")\nprint(f\"Cell lines: {df['cell'].unique()}\")\n\n# Convert to numeric\nfor gene in glyco_genes:\n    if gene in df.columns:\n        df[gene] = pd.to_numeric(df[gene], errors='coerce')\n\ndf.head()"
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": "## 2. Pure Rank Algorithm Implementation\n\n### 2.1 Per-sample Rank Calculation"
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def calculate_sample_ranks(df: pd.DataFrame, glyco_genes: List[str]) -> Tuple[pd.DataFrame, pd.DataFrame]:\n",
    "    \"\"\"\n",
    "    各サンプルについて、glycogeneのz-scoreをrankに変換する\n",
    "    \n",
    "    Returns:\n",
    "    --------\n",
    "    Tuple[pd.DataFrame, pd.DataFrame]\n",
    "        (rank_mag_df, rank_signed_df)\n",
    "        - rank_mag_df: magnitude rank（|z|降順、値が小さい=強い応答）\n",
    "        - rank_signed_df: signed rank（z昇順、値が小さい=下方制御）\n",
    "    \"\"\"\n",
    "    print(\"サンプルごとのrank計算を開始...\")\n",
    "    \n",
    "    # サンプルIDとメタデータを抽出\n",
    "    meta_cols = ['sample_id', 'pertname', 'pertid', 'cell', 'dose', 'timepoint']\n",
    "    \n",
    "    # 実際に存在する遺伝子カラムのみを使用\n",
    "    actual_gene_cols = [g for g in glyco_genes if g in df.columns]\n",
    "    print(f\"  使用する遺伝子数: {len(actual_gene_cols)}\")\n",
    "    \n",
    "    df_genes = df[actual_gene_cols].copy()\n",
    "    \n",
    "    # (A) Magnitude rank: |z|降順 → 値が小さいほど強い応答\n",
    "    # ascending=Falseにして|z|が大きいものに小さいrankを付与\n",
    "    rank_mag = df_genes.abs().rank(axis=1, method='average', ascending=False)\n",
    "    \n",
    "    # (B) Signed rank: z昇順 → 値が小さいほど下方制御\n",
    "    rank_signed = df_genes.rank(axis=1, method='average', ascending=True)\n",
    "    \n",
    "    # メタデータを付与\n",
    "    rank_mag_df = pd.concat([df[meta_cols].reset_index(drop=True), rank_mag.reset_index(drop=True)], axis=1)\n",
    "    rank_signed_df = pd.concat([df[meta_cols].reset_index(drop=True), rank_signed.reset_index(drop=True)], axis=1)\n",
    "    \n",
    "    print(f\"  Magnitude rank: {rank_mag_df.shape}\")\n",
    "    print(f\"  Signed rank: {rank_signed_df.shape}\")\n",
    "    print(f\"  サンプル数: {len(rank_mag_df):,}\")\n",
    "    \n",
    "    return rank_mag_df, rank_signed_df, actual_gene_cols\n",
    "\n",
    "# rank計算実行\n",
    "rank_mag_df, rank_signed_df, actual_gene_cols = calculate_sample_ranks(df, glyco_genes)\n",
    "\n",
    "# 以降の処理で使うglyco_genesを実際の遺伝子リストに更新\n",
    "glyco_genes = actual_gene_cols"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# rank計算の確認（最初のサンプル）\n",
    "sample_idx = 0\n",
    "sample_id = df.iloc[sample_idx]['sample_id']\n",
    "\n",
    "print(f\"サンプル: {sample_id}\")\n",
    "print(f\"\\n元のz-score（Top 5 by |z|）:\")\n",
    "\n",
    "# 実際に存在する遺伝子カラムのみを使用\n",
    "actual_gene_cols = [g for g in glyco_genes if g in df.columns]\n",
    "z_vals = df.iloc[sample_idx][actual_gene_cols].astype(float)\n",
    "top5_genes = z_vals.abs().nlargest(5).index\n",
    "for gene in top5_genes:\n",
    "    z = z_vals[gene]\n",
    "    rank_m = rank_mag_df.iloc[sample_idx][gene]\n",
    "    rank_s = rank_signed_df.iloc[sample_idx][gene]\n",
    "    print(f\"  {gene}: z={z:.4f}, mag_rank={rank_m:.0f}, signed_rank={rank_s:.0f}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": "### 2.2 Per-Drug Rank Aggregation (Median)"
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def aggregate_drug_ranks(\n",
    "    rank_df: pd.DataFrame, \n",
    "    glyco_genes: List[str],\n",
    "    min_samples: int = 3\n",
    ") -> pd.DataFrame:\n",
    "    \"\"\"\n",
    "    薬剤ごとにrankの中央値を集約する\n",
    "    \n",
    "    Parameters:\n",
    "    -----------\n",
    "    rank_df : pd.DataFrame\n",
    "        サンプルごとのrankデータ（meta + rank columns）\n",
    "    glyco_genes : List[str]\n",
    "        glycogene名リスト\n",
    "    min_samples : int\n",
    "        最小サンプル数（デフォルト: 3）\n",
    "    \n",
    "    Returns:\n",
    "    --------\n",
    "    pd.DataFrame\n",
    "        drug×gene形式の集約スコア（n_samples列付き）\n",
    "    \"\"\"\n",
    "    print(f\"薬剤ごとのrank集約（min_samples={min_samples}）...\")\n",
    "    \n",
    "    results = []\n",
    "    drug_sample_counts = rank_df.groupby('pertname').size()\n",
    "    \n",
    "    # min_samples以上のサンプルを持つ薬剤のみ\n",
    "    valid_drugs = drug_sample_counts[drug_sample_counts >= min_samples].index\n",
    "    print(f\"  対象薬剤数: {len(valid_drugs)} / {len(drug_sample_counts)}\")\n",
    "    \n",
    "    for drug in valid_drugs:\n",
    "        drug_data = rank_df[rank_df['pertname'] == drug]\n",
    "        n_samples = len(drug_data)\n",
    "        \n",
    "        for gene in glyco_genes:\n",
    "            if gene not in drug_data.columns:\n",
    "                continue\n",
    "            \n",
    "            ranks = drug_data[gene].dropna()\n",
    "            if len(ranks) < min_samples:\n",
    "                continue\n",
    "            \n",
    "            median_rank = ranks.median()\n",
    "            \n",
    "            results.append({\n",
    "                'drug': drug,\n",
    "                'gene': gene,\n",
    "                'score': median_rank,\n",
    "                'n_samples': n_samples\n",
    "            })\n",
    "    \n",
    "    df_result = pd.DataFrame(results)\n",
    "    print(f\"  結果: {len(df_result):,}レコード（{df_result['drug'].nunique()}薬剤 × {df_result['gene'].nunique()}遺伝子）\")\n",
    "    \n",
    "    return df_result\n",
    "\n",
    "# magnitude rankの薬剤集約（デフォルトmin_samples=3）\n",
    "df_drug_scores_mag = aggregate_drug_ranks(rank_mag_df, glyco_genes, min_samples=3)\n",
    "\n",
    "# signed rankの薬剤集約\n",
    "df_drug_scores_signed = aggregate_drug_ranks(rank_signed_df, glyco_genes, min_samples=3)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 集約結果の確認\n",
    "print(\"【Magnitude rank集約スコア】\")\n",
    "print(df_drug_scores_mag.head(10))\n",
    "print(f\"\\nスコア分布:\")\n",
    "print(df_drug_scores_mag['score'].describe())"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": "## 3. TopN Gene Extraction and Frequency Counting"
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def extract_topN_genes(\n",
    "    df_scores: pd.DataFrame,\n",
    "    top_n: int = 20\n",
    ") -> pd.DataFrame:\n",
    "    \"\"\"\n",
    "    各薬剤についてTopN遺伝子を抽出（scoreが小さい順=強応答）\n",
    "    \n",
    "    Parameters:\n",
    "    -----------\n",
    "    df_scores : pd.DataFrame\n",
    "        drug×geneの集約スコア（columns: drug, gene, score, n_samples）\n",
    "    top_n : int\n",
    "        抽出する上位N遺伝子\n",
    "    \n",
    "    Returns:\n",
    "    --------\n",
    "    pd.DataFrame\n",
    "        TopN遺伝子（columns: drug, gene, rank_within_drug, score, n_samples）\n",
    "    \"\"\"\n",
    "    results = []\n",
    "    \n",
    "    for drug in df_scores['drug'].unique():\n",
    "        drug_data = df_scores[df_scores['drug'] == drug].copy()\n",
    "        # scoreが小さい順にソート（小さい=強い応答）\n",
    "        drug_data = drug_data.nsmallest(top_n, 'score').reset_index(drop=True)\n",
    "        drug_data['rank_within_drug'] = range(1, len(drug_data) + 1)\n",
    "        results.append(drug_data)\n",
    "    \n",
    "    df_topN = pd.concat(results, ignore_index=True)\n",
    "    return df_topN[['drug', 'gene', 'rank_within_drug', 'score', 'n_samples']]\n",
    "\n",
    "\n",
    "def count_gene_frequency(\n",
    "    df_topN: pd.DataFrame,\n",
    "    n_drugs: int\n",
    ") -> pd.DataFrame:\n",
    "    \"\"\"\n",
    "    遺伝子の頻度カウント\n",
    "    \n",
    "    Returns:\n",
    "    --------\n",
    "    pd.DataFrame\n",
    "        columns: gene, freq, freq_percent\n",
    "    \"\"\"\n",
    "    gene_counts = df_topN['gene'].value_counts().reset_index()\n",
    "    gene_counts.columns = ['gene', 'freq']\n",
    "    gene_counts['freq_percent'] = gene_counts['freq'] / n_drugs * 100\n",
    "    return gene_counts\n",
    "\n",
    "\n",
    "# TopN抽出（N=20）\n",
    "TOP_N_DEFAULT = 20\n",
    "df_topN_mag = extract_topN_genes(df_drug_scores_mag, top_n=TOP_N_DEFAULT)\n",
    "\n",
    "# 頻度カウント\n",
    "n_drugs = df_drug_scores_mag['drug'].nunique()\n",
    "df_gene_freq = count_gene_frequency(df_topN_mag, n_drugs)\n",
    "\n",
    "print(f\"【TopN遺伝子抽出結果】\")\n",
    "print(f\"  N = {TOP_N_DEFAULT}\")\n",
    "print(f\"  総レコード数: {len(df_topN_mag):,}\")\n",
    "print(f\"  薬剤数: {df_topN_mag['drug'].nunique()}\")\n",
    "print(f\"  遺伝子数: {df_topN_mag['gene'].nunique()}\")\n",
    "\n",
    "print(f\"\\n【頻出遺伝子 Top 20】\")\n",
    "for i, row in df_gene_freq.head(20).iterrows():\n",
    "    print(f\"  {i+1:2d}. {row['gene']:15s}: {row['freq']:4d}薬剤 ({row['freq_percent']:5.1f}%)\")"
   ]
  },
  {
