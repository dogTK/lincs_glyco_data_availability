  {
   "cell_type": "markdown",
   "metadata": {},
   "source": "## 7. GlycoEnzOnto Enrichment Analysis"
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# GlycoEnzOnto GMTファイルを読み込み\n",
    "gmt_file = project_root / 'GlycoEnzOnto' / 'GlycoEnzOnto.gmt'\n",
    "\n",
    "def read_gmt(gmt_path):\n",
    "    \"\"\"GMTファイルを読み込んでパスウェイ辞書を返す\"\"\"\n",
    "    pathways = {}\n",
    "    with open(gmt_path, 'r') as f:\n",
    "        for line in f:\n",
    "            parts = line.strip().split('\\t')\n",
    "            pathway_name = parts[0].strip('\"').strip(\"'\")\n",
    "            genes = [g.strip('\"').strip(\"'\") for g in parts[2:]]\n",
    "            pathways[pathway_name] = set(genes)\n",
    "    return pathways\n",
    "\n",
    "pathways = read_gmt(gmt_file)\n",
    "print(f'GlycoEnzOnto パスウェイ数: {len(pathways)}')\n",
    "\n",
    "\n",
    "def perform_enrichment_analysis(cluster_genes, all_genes, pathways, min_overlap=2):\n",
    "    \"\"\"\n",
    "    フィッシャーの正確検定によるエンリッチメント解析\n",
    "    \"\"\"\n",
    "    results = []\n",
    "    \n",
    "    n_cluster = len(cluster_genes)\n",
    "    n_background = len(all_genes)\n",
    "    \n",
    "    for pathway_name, pathway_genes in pathways.items():\n",
    "        pathway_genes_in_background = pathway_genes & all_genes\n",
    "        \n",
    "        if len(pathway_genes_in_background) == 0:\n",
    "            continue\n",
    "        \n",
    "        overlap = cluster_genes & pathway_genes_in_background\n",
    "        n_overlap = len(overlap)\n",
    "        \n",
    "        if n_overlap < min_overlap:\n",
    "            continue\n",
    "        \n",
    "        a = n_overlap\n",
    "        b = len(pathway_genes_in_background) - a\n",
    "        c = n_cluster - a\n",
    "        d = n_background - n_cluster - b\n",
    "        \n",
    "        oddsratio, pvalue = fisher_exact([[a, b], [c, d]], alternative='greater')\n",
    "        \n",
    "        expected = (n_cluster * len(pathway_genes_in_background)) / n_background\n",
    "        fold_enrichment = n_overlap / expected if expected > 0 else 0\n",
    "        \n",
    "        results.append({\n",
    "            'pathway': pathway_name,\n",
    "            'overlap': n_overlap,\n",
    "            'cluster_size': n_cluster,\n",
    "            'pathway_size': len(pathway_genes_in_background),\n",
    "            'expected': expected,\n",
    "            'fold_enrichment': fold_enrichment,\n",
    "            'odds_ratio': oddsratio,\n",
    "            'p_value': pvalue,\n",
    "            'genes': ','.join(sorted(overlap))\n",
    "        })\n",
    "    \n",
    "    if not results:\n",
    "        return pd.DataFrame()\n",
    "    \n",
    "    df_results = pd.DataFrame(results)\n",
    "    \n",
    "    if len(df_results) > 0:\n",
    "        _, qvalues, _, _ = multipletests(df_results['p_value'], method='fdr_bh')\n",
    "        df_results['q_value'] = qvalues\n",
    "    \n",
    "    df_results = df_results.sort_values('p_value')\n",
    "    \n",
    "    return df_results\n",
    "\n",
    "print('\\nエンリッチメント解析関数を定義しました')"
   ]
  },
