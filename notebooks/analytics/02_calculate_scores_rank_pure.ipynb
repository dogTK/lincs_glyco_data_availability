    "# Directionality計算（signed rankから）\n",
    "def compute_directionality(df_signed: pd.DataFrame) -> pd.DataFrame:\n",
    "    \"\"\"\n",
    "    遺伝子ごとの方向性（上方/下方制御傾向）を計算\n",
    "    \n",
    "    signed rank: 低い = 下方制御, 高い = 上方制御\n",
    "    directionality = (median_rank - midpoint) / midpoint\n",
    "      → 正: 上方制御傾向, 負: 下方制御傾向\n",
    "    \"\"\"\n",
    "    n_genes = 385  # 遺伝子数\n",
    "    midpoint = (n_genes + 1) / 2  # 中央値 = 193\n",
    "    \n",
    "    results = []\n",
    "    for gene in df_signed['gene'].unique():\n",
    "        gene_data = df_signed[df_signed['gene'] == gene]['score']\n",
    "        median_rank = gene_data.median()\n",
    "        \n",
    "        # Directionality: 中央からの偏り\n",
    "        directionality = (median_rank - midpoint) / midpoint\n",
    "        \n",
    "        results.append({\n",
    "            'gene': gene,\n",
    "            'median_signed_rank': median_rank,\n",
    "            'directionality': directionality\n",
    "        })\n",
    "    \n",
    "    return pd.DataFrame(results)\n",
    "\n",
    "df_directionality = compute_directionality(df_drug_scores_signed)\n",
    "\n",
    "# 既存のdirectionalityカラムがあれば削除してからマージ\n",
    "if 'directionality' in df_gene_metrics.columns:\n",
    "    df_gene_metrics = df_gene_metrics.drop(columns=['directionality', 'median_signed_rank'], errors='ignore')\n",
    "\n",
    "df_gene_metrics = df_gene_metrics.merge(df_directionality, on='gene', how='left')\n",
    "\n",
    "print(\"【Directionality分布】\")\n",
    "print(df_gene_metrics['directionality'].describe())\n",
    "\n",
    "# 上方/下方制御傾向の強い遺伝子\n",
    "up_genes = df_gene_metrics.nlargest(10, 'directionality')[['gene', 'directionality']]\n",
    "down_genes = df_gene_metrics.nsmallest(10, 'directionality')[['gene', 'directionality']]\n",
    "\n",
    "print(f\"\\n【上方制御傾向 Top 10】\")\n",
    "for _, row in up_genes.iterrows():\n",
    "    print(f\"  {row['gene']:15s}: {row['directionality']:+.3f}\")\n",
    "\n",
    "print(f\"\\n【下方制御傾向 Top 10】\")\n",
    "for _, row in down_genes.iterrows():\n",
    "    print(f\"  {row['gene']:15s}: {row['directionality']:+.3f}\")"
   ]
