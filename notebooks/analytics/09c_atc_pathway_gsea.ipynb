   "source": "# Run GSEA for all ATC classes (L2)\nprint('='*80)\nprint('GlycoEnzOnto Pathway GSEA Analysis by ATC Class (L2)')\nprint('='*80)\n\nN_PERMUTATIONS = 1000\nMIN_PATHWAY_SIZE = 5\nMAX_PATHWAY_SIZE = 200\nQ_THRESHOLD = 0.05\n\nall_gsea_results = []\natc_summary = []\n\nfor atc_class in sorted(df_with_atc['atc_class'].unique()):\n    df_atc = df_with_atc[df_with_atc['atc_class'] == atc_class]\n    n_compounds = df_atc['pertname'].nunique()\n    n_samples = len(df_atc)\n    \n    print(f'\\n{atc_class}: {n_compounds} compounds, {n_samples} samples')\n    \n    # Calculate gene scores\n    df_scores = calculate_gene_scores(df_atc, glyco_genes)\n    \n    if len(df_scores) < 50:\n        print(f'  Skipped (insufficient genes: {len(df_scores)})')\n        continue\n    \n    # Run GSEA\n    df_gsea = run_gsea_prerank(\n        df_scores, pathways, \n        n_permutations=N_PERMUTATIONS,\n        min_size=MIN_PATHWAY_SIZE,\n        max_size=MAX_PATHWAY_SIZE\n    )\n    \n    if len(df_gsea) > 0:\n        df_gsea['atc_class'] = atc_class\n        df_gsea['n_compounds'] = n_compounds\n        df_gsea['n_samples'] = n_samples\n        \n        n_sig = (df_gsea['q_value'] < Q_THRESHOLD).sum()\n        n_sig_strict = (df_gsea['q_value'] < 0.01).sum()\n        \n        # Top up/down pathways\n        top_up = df_gsea[df_gsea['nes'] > 0].nsmallest(3, 'p_value')['pathway'].tolist()\n        top_down = df_gsea[df_gsea['nes'] < 0].nsmallest(3, 'p_value')['pathway'].tolist()\n        \n        print(f'  Significant pathways: q<{Q_THRESHOLD}={n_sig}, q<0.01={n_sig_strict}')\n        if top_up:\n            print(f'  Top up: {top_up[0][:40]}...' if len(top_up[0]) > 40 else f'  Top up: {top_up[0]}')\n        if top_down:\n            print(f'  Top down: {top_down[0][:40]}...' if len(top_down[0]) > 40 else f'  Top down: {top_down[0]}')\n        \n        all_gsea_results.append(df_gsea)\n    \n    atc_summary.append({\n        'atc_class': atc_class,\n        'n_compounds': n_compounds,\n        'n_samples': n_samples,\n        'n_genes_scored': len(df_scores),\n        'mean_top_zscore': df_scores.head(10)['mean_zscore'].mean() if len(df_scores) >= 10 else np.nan,\n        'mean_bottom_zscore': df_scores.tail(10)['mean_zscore'].mean() if len(df_scores) >= 10 else np.nan\n    })\n\n# Combine results\nif all_gsea_results:\n    df_all_gsea = pd.concat(all_gsea_results, ignore_index=True)\n    df_sig = df_all_gsea[df_all_gsea['q_value'] < Q_THRESHOLD]\n    \n    print(f'\\n{\"=\"*80}')\n    print(f'Total GSEA results: {len(df_all_gsea)} records')\n    print(f'Significant enrichment (q<{Q_THRESHOLD}): {len(df_sig)}')\n    print(f'  Upregulated (NES>0): {(df_sig[\"nes\"] > 0).sum()}')\n    print(f'  Downregulated (NES<0): {(df_sig[\"nes\"] < 0).sum()}')\n    print(f'Number of ATC classes: {df_sig[\"atc_class\"].nunique()}')\n    \n    # Save\n    df_all_gsea.to_csv(results_dir / 'atc_L2_pathway_gsea.csv', index=False)\n    print(f'\\nSaved: {results_dir / \"atc_L2_pathway_gsea.csv\"}')\nelse:\n    df_all_gsea = pd.DataFrame()\n    df_sig = pd.DataFrame()\n    print('No GSEA results')\n\n# Save summary\ndf_atc_summary = pd.DataFrame(atc_summary)\ndf_atc_summary.to_csv(results_dir / 'atc_L2_gsea_summary.csv', index=False)\nprint(f'Summary saved: {results_dir / \"atc_L2_gsea_summary.csv\"}')"
