   "source": "# Load GlycoEnzOnto GMT file\ngmt_file = project_root / 'GlycoEnzOnto' / 'GlycoEnzOnto.gmt'\n\ndef read_gmt(gmt_path):\n    pathways = {}\n    descriptions = {}\n    with open(gmt_path, 'r') as f:\n        for line in f:\n            parts = line.strip().split('\\t')\n            pathway_name = parts[0].strip('\"').strip(\"'\")\n            description = parts[1].strip('\"').strip(\"'\") if len(parts) > 1 else ''\n            genes = [g.strip('\"').strip(\"'\") for g in parts[2:]]\n            pathways[pathway_name] = set(genes)\n            descriptions[pathway_name] = description\n    return pathways, descriptions\n\npathways, pathway_descriptions = read_gmt(gmt_file)\n\nprint(f'GlycoEnzOnto pathway information:')\nprint(f'  Total pathways: {len(pathways)}')\npathway_sizes = [len(genes) for genes in pathways.values()]\nprint(f'  Pathway sizes: min={min(pathway_sizes)}, max={max(pathway_sizes)}, mean={np.mean(pathway_sizes):.1f}')"
  },
  {
   "cell_type": "markdown",
   "id": "10",
   "metadata": {},
   "source": "## 4. Retrieve ATC Codes (Snowflake ATC_COMPOUND_MAP Table)\n\nUsing the ATC code master table (`ATC_COMPOUND_MAP`) obtained from ChEMBL.\nMatching by first 14 characters of InChIKey (to accommodate stereoisomer differences).\n\n**What is ATC Code (Anatomical Therapeutic Chemical)?**\n- International standard classification code assigned by WHO to approved drugs\n- Research compounds (BRD-XXX) and unapproved drugs do not have ATC codes\n- Since LINCS is a drug screening library, coverage is approximately 20%"
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "11",
   "metadata": {},
   "outputs": [],
   "source": "import re\n\n# ATC code regex pattern\nATC_PATTERN = re.compile(r'^[A-Z][0-9]{2}[A-Z]{1,2}[0-9]{2}$')\n\ndef is_valid_atc_code(code: str) -> bool:\n    if not code or pd.isna(code):\n        return False\n    return bool(ATC_PATTERN.match(code))\n\n# ==============================================================================\n# ATC Code Retrieval: Using Snowflake ATC_COMPOUND_MAP table (first 14 characters match)\n# ==============================================================================\n# ATC codes are classification codes assigned only to WHO-approved drugs\n# LINCS contains many research compounds (BRD-XXX), so coverage is approximately 20%\n\nprint(\"=\"*70)\nprint(\"ATC Code Retrieval (Snowflake ATC_COMPOUND_MAP Table)\")\nprint(\"=\"*70)\n\n# Matching by first 14 characters of InChIKey (to accommodate stereoisomer differences)\natc_query = '''\nWITH lincs_compounds AS (\n    SELECT DISTINCT \n        \"inchi_key\",\n        SUBSTRING(\"inchi_key\", 1, 14) as inchi_key_14,\n        \"pertname\"\n    FROM BIOINFORMATICS.LINCS.GLYCO_GENES_WIDE\n    WHERE \"cell\" IN ('HEPG2', 'HUH7', 'JHH7')\n      AND \"inchi_key\" IS NOT NULL \n      AND \"inchi_key\" != ''\n)\nSELECT \n    l.\"inchi_key\",\n    l.\"pertname\",\n    a.ATC_CODE,\n    a.PREF_NAME as atc_name\nFROM lincs_compounds l\nLEFT JOIN BIOINFORMATICS.LINCS.ATC_COMPOUND_MAP a \n    ON l.inchi_key_14 = a.INCHI_KEY_14\n'''\n\ndf_atc_map = pd.read_sql(atc_query, conn)\n\n# Extract only valid ATC codes\ndf_atc_valid = df_atc_map[df_atc_map['ATC_CODE'].apply(is_valid_atc_code)].copy()\n\n# Create InChIKey -> ATC code mapping (1 compound : 1 ATC code)\n# If multiple ATCs exist, use the first one\ninchi_to_atc = df_atc_valid.drop_duplicates('inchi_key').set_index('inchi_key')['ATC_CODE'].to_dict()\n\nprint(f\"Valid ATC mappings: {len(inchi_to_atc)}\")\n\n# Add ATC to data\ndf_with_inchi['atc_code'] = df_with_inchi['inchi_key'].map(inchi_to_atc)\ndf_with_atc = df_with_inchi[df_with_inchi['atc_code'].notna()].copy()\n\nprint(f'\\nCompounds with ATC code: {df_with_atc[\"pertname\"].nunique()}')\nprint(f'Records with ATC code: {len(df_with_atc):,}')"
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "12",
   "metadata": {},
   "outputs": [],
   "source": "# ==============================================================================\n# ATC Coverage Statistics (Coverage of WHO-approved drugs)\n# ==============================================================================\n\ncoverage_query = '''\nWITH liver_compounds AS (\n    SELECT DISTINCT \n        \"pertname\",\n        \"inchi_key\",\n        SUBSTRING(\"inchi_key\", 1, 14) as inchi_key_14,\n        CASE WHEN \"pertname\" LIKE 'BRD-%%' THEN 1 ELSE 0 END as is_brd\n    FROM BIOINFORMATICS.LINCS.GLYCO_GENES_WIDE\n    WHERE \"cell\" IN ('HEPG2', 'HUH7', 'JHH7')\n)\nSELECT \n    COUNT(DISTINCT \"pertname\") as total_compounds,\n    COUNT(DISTINCT CASE WHEN \"inchi_key\" IS NOT NULL AND \"inchi_key\" != '' THEN \"pertname\" END) as with_inchikey,\n    COUNT(DISTINCT CASE WHEN is_brd = 1 THEN \"pertname\" END) as brd_compounds,\n    COUNT(DISTINCT CASE WHEN is_brd = 0 AND \"inchi_key\" IS NOT NULL AND \"inchi_key\" != '' THEN \"pertname\" END) as named_compounds,\n    COUNT(DISTINCT CASE WHEN a.INCHI_KEY_14 IS NOT NULL THEN l.\"pertname\" END) as atc_matched\nFROM liver_compounds l\nLEFT JOIN BIOINFORMATICS.LINCS.ATC_COMPOUND_MAP a \n    ON l.inchi_key_14 = a.INCHI_KEY_14\n'''\n\ndf_coverage = pd.read_sql(coverage_query, conn)\n\ntotal = df_coverage['TOTAL_COMPOUNDS'].iloc[0]\nwith_inchi = df_coverage['WITH_INCHIKEY'].iloc[0]\nbrd = df_coverage['BRD_COMPOUNDS'].iloc[0]\nnamed = df_coverage['NAMED_COMPOUNDS'].iloc[0]\natc_matched = df_coverage['ATC_MATCHED'].iloc[0]\n\nprint(\"=\"*70)\nprint(\"ATC Coverage Statistics (Liver cancer cell lines: HEPG2, HUH7, JHH7)\")\nprint(\"=\"*70)\nprint(f\"\\n[Data Composition]\")\nprint(f\"  Total compounds: {total:,}\")\nprint(f\"  With InChIKey: {with_inchi:,} ({with_inchi/total*100:.1f}%)\")\nprint(f\"    - BRD-XXX (research IDs): {brd:,} ({brd/total*100:.1f}%)\")\nprint(f\"    - Named compounds: {named:,} ({named/total*100:.1f}%)\")\n\nprint(f\"\\n[ATC Matching Results]\")\nprint(f\"  With ATC code (WHO-approved drugs): {atc_matched:,} ({atc_matched/with_inchi*100:.1f}%)\")\n\nprint(f\"\\n[Reasons for ~20% coverage]\")\nprint(f\"  1. BRD-XXX ({brd:,}): Broad Institute research compound IDs -> no ATC code\")\nprint(f\"  2. Research-stage compounds: Pre-clinical to Phase 3 compounds -> unapproved, no ATC code\")\nprint(f\"  3. ATC codes: International standard classification assigned only to WHO-approved drugs\")\nprint(f\"\\n-> Coverage of {atc_matched/with_inchi*100:.1f}% means LINCS contains approximately {atc_matched/with_inchi*100:.0f}% approved drugs\")"
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "13",
   "metadata": {},
   "outputs": [],
   "source": "# Round ATC to L2 level (3 characters) - More specific than L1, higher power than L3\ndef get_atc_level(atc_code: str, level: int) -> str:\n    if not atc_code or pd.isna(atc_code):\n        return None\n    if level == 1:\n        return atc_code[0]\n    elif level == 2:\n        return atc_code[:3]\n    elif level == 3:\n        return atc_code[:4]\n    elif level == 4:\n        return atc_code[:5]\n    else:\n        return atc_code\n\n# L2 level (3 characters): e.g., L01D -> L01 (antineoplastic agents), N05A -> N05 (psycholeptics)\n# Representative L2 classifications:\n#   L01: Antineoplastic agents, L02: Endocrine therapy, L04: Immunosuppressants\n#   N05: Psycholeptics, N06: Psychoanaleptics\n#   C08: Calcium channel blockers, C10: Lipid modifying agents\ndf_with_atc['atc_class'] = df_with_atc['atc_code'].apply(lambda x: get_atc_level(x, 2))\n\n# Number of compounds and samples per ATC class\natc_stats = df_with_atc.groupby('atc_class').agg({\n    'pertname': 'nunique',\n    'sample_id': 'count'\n}).rename(columns={'pertname': 'n_compounds', 'sample_id': 'n_samples'})\natc_stats = atc_stats.sort_values('n_samples', ascending=False)\n\nprint(f'Number of ATC classes (L2): {len(atc_stats)}')\n\n# Filter by minimum sample count (GSEA works with fewer samples, so threshold is relaxed)\nMIN_SAMPLES = 10\nvalid_atc_classes = atc_stats[atc_stats['n_samples'] >= MIN_SAMPLES].index.tolist()\nprint(f'\\nValid ATC classes (samples >= {MIN_SAMPLES}): {len(valid_atc_classes)}')\n\ndf_with_atc = df_with_atc[df_with_atc['atc_class'].isin(valid_atc_classes)].copy()\nprint(f'Records after filtering: {len(df_with_atc):,}')\n\n# Display all classes\nprint('\\nAll ATC classes (L2 level):')\nfor atc in atc_stats.index:\n    row = atc_stats.loc[atc]\n    status = 'Y' if atc in valid_atc_classes else 'N'\n    print(f'  {status} {atc}: {row[\"n_compounds\"]} compounds, {row[\"n_samples\"]} samples')"
  },
  {
   "cell_type": "markdown",
   "id": "14",
   "metadata": {},
   "source": "### ATC Code Classification System Overview\n\n**ATC (Anatomical Therapeutic Chemical) Classification** is the international standard drug classification system defined by WHO.\n\n#### ATC Code Structure (7 characters)\n```\nL 01 D C 01\n│ │  │ │ └─ 5th level: Chemical substance (individual drug)\n│ │  │ └─── 4th level: Chemical subgroup\n│ │  └───── 3rd level: Pharmacological subgroup\n│ └──────── 2nd level: Therapeutic subgroup ← Used in this analysis (L2)\n└────────── 1st level: Anatomical main group\n```\n\n#### ATC Classes Used in This Analysis (L2 Level = 3 characters)\n\n| ATC Class | Meaning | Examples |\n|-----------|---------|----------|\n| **L01** | Antineoplastic agents | Doxorubicin, Cisplatin |\n| **L02** | Endocrine therapy | Tamoxifen |\n| **L04** | Immunosuppressants | Cyclosporine |\n| **J01** | Systemic antibacterials | Penicillins |\n| **J02** | Systemic antimycotics | Fluconazole |\n| **J04** | Antimycobacterials | Rifampicin |\n| **N02** | Analgesics | Morphine, Acetaminophen |\n| **N03** | Antiepileptics | Valproic acid |\n| **N05** | Psycholeptics | Diazepam |\n| **N06** | Psychoanaleptics | Fluoxetine |\n| **C01** | Cardiac therapy | Digoxin |\n| **C02** | Antihypertensives | Clonidine |\n| **C03** | Diuretics | Furosemide |\n| **C08** | Calcium channel blockers | Nifedipine |\n| **C09** | RAS-acting agents (ACE inhibitors/ARBs) | Enalapril |\n| **C10** | Lipid modifying agents | Statins |\n| **A07** | Antidiarrheals | Loperamide |\n| **A10** | Drugs used in diabetes | Metformin |\n| **G03** | Sex hormones | Estradiol |\n| **P01** | Antiprotozoals | Metronidazole |\n| **R03** | Obstructive airway disease drugs | Salbutamol |\n| **R06** | Antihistamines | Cetirizine |\n| **S01** | Ophthalmologicals | Timolol |\n| **D02** | Emollients | Urea preparations |\n\n#### Interpretation Points\n\n- **L01 (Antineoplastic agents)** has the largest sample size -> highest detection power\n- Even within the same 1st level (e.g., L = antineoplastic and immunomodulating agents), mechanisms differ significantly at L2\n- Responses in liver cancer cell lines (HEPG2, HUH7, JHH7) tend to show changes related to hepatic metabolism and hepatotoxicity"
  },
  {
   "cell_type": "markdown",
   "id": "15",
   "metadata": {},
   "source": "## 5. Rank-based Enrichment Analysis (GSEA)\n\n**Method Change: Fisher's exact test -> GSEA**\n\nInstead of binary DEG classification, run GSEA on gene z-score rankings for each ATC class.\nEnrichment detection is possible even with small sample sizes.\n\n1. Calculate mean z-score for each gene per ATC class\n2. Rank by z-score\n3. Run GSEA (Kolmogorov-Smirnov test based) for each pathway"
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "16",
   "metadata": {},
   "outputs": [],
   "source": "from scipy.stats import rankdata, kstest\nimport warnings\n\ndef calculate_gene_scores(df_atc: pd.DataFrame, glyco_genes: List[str]) -> pd.DataFrame:\n    \"\"\"\n    Calculate gene scores (mean z-score) from ATC class data\n    \"\"\"\n    results = []\n    for gene in glyco_genes:\n        if gene not in df_atc.columns:\n            continue\n        values = df_atc[gene].dropna().values\n        if len(values) < 3:\n            continue\n        mean_zscore = np.mean(values)\n        std_zscore = np.std(values)\n        results.append({\n            'gene': gene,\n            'mean_zscore': mean_zscore,\n            'std_zscore': std_zscore,\n            'n_samples': len(values)\n        })\n    \n    if not results:\n        return pd.DataFrame()\n    \n    df_scores = pd.DataFrame(results)\n    df_scores = df_scores.sort_values('mean_zscore', ascending=False)\n    df_scores['rank'] = range(1, len(df_scores) + 1)\n    return df_scores\n\n\ndef run_gsea_prerank(gene_scores: pd.DataFrame, pathways: Dict[str, Set[str]], \n                     n_permutations: int = 1000, min_size: int = 5, max_size: int = 500,\n                     seed: int = 42) -> pd.DataFrame:\n    \"\"\"\n    Rank-based GSEA (prerank version)\n    \n    Parameters:\n        gene_scores: DataFrame with gene, mean_zscore columns (sorted)\n        pathways: pathway name -> gene set\n        n_permutations: number of permutations\n        min_size, max_size: pathway size filters\n    \"\"\"\n    np.random.seed(seed)\n    \n    # Create ranking list\n    ranked_genes = gene_scores['gene'].tolist()\n    scores = gene_scores['mean_zscore'].values\n    n_genes = len(ranked_genes)\n    gene_to_idx = {g: i for i, g in enumerate(ranked_genes)}\n    \n    results = []\n    \n    for pathway_name, pathway_genes in pathways.items():\n        # Pathway genes present in the ranking\n        pathway_genes_in_list = [g for g in pathway_genes if g in gene_to_idx]\n        n_hit = len(pathway_genes_in_list)\n        \n        if n_hit < min_size or n_hit > max_size:\n            continue\n        \n        # Hit gene indices\n        hit_indices = sorted([gene_to_idx[g] for g in pathway_genes_in_list])\n        \n        # Calculate Enrichment Score\n        es, leading_edge = calculate_enrichment_score(scores, hit_indices, n_genes)\n        \n        # Permutation test\n        null_es = []\n        for _ in range(n_permutations):\n            perm_indices = sorted(np.random.choice(n_genes, n_hit, replace=False))\n            perm_es, _ = calculate_enrichment_score(scores, perm_indices, n_genes)\n            null_es.append(perm_es)\n        \n        null_es = np.array(null_es)\n        \n        # Calculate p-value (two-sided test)\n        if es >= 0:\n            p_value = np.mean(null_es >= es)\n        else:\n            p_value = np.mean(null_es <= es)\n        \n        # NES (Normalized Enrichment Score) - correct implementation preserving sign\n        if es >= 0:\n            pos_null = null_es[null_es >= 0]\n            nes = es / np.mean(pos_null) if len(pos_null) > 0 and np.mean(pos_null) != 0 else 0\n        else:\n            neg_null = null_es[null_es < 0]\n            # Negative ES normalized by absolute value of mean negative null distribution (preserving sign)\n            # es/mean(neg_null) would give neg/neg=pos, so divide by absolute value\n            nes = es / np.abs(np.mean(neg_null)) if len(neg_null) > 0 and np.mean(neg_null) != 0 else 0\n        \n        # Leading edge genes\n        le_genes = [ranked_genes[i] for i in leading_edge]\n        \n        results.append({\n            'pathway': pathway_name,\n            'es': es,\n            'nes': nes,\n            'p_value': max(p_value, 1/n_permutations),  # minimum p-value\n            'n_genes': n_hit,\n            'leading_edge_size': len(le_genes),\n            'leading_edge_genes': ', '.join(le_genes[:10])  # top 10 genes\n        })\n    \n    if not results:\n        return pd.DataFrame()\n    \n    df_results = pd.DataFrame(results)\n    \n    # FDR correction\n    _, pvals_corrected, _, _ = multipletests(df_results['p_value'], method='fdr_bh')\n    df_results['q_value'] = pvals_corrected\n    \n    return df_results.sort_values('p_value')\n\n\ndef calculate_enrichment_score(scores: np.ndarray, hit_indices: List[int], n_genes: int):\n    \"\"\"\n    Calculate Enrichment Score (standard GSEA algorithm)\n    \"\"\"\n    n_hit = len(hit_indices)\n    n_miss = n_genes - n_hit\n    \n    # Weighted scores\n    hit_scores = np.abs(scores[hit_indices])\n    hit_sum = np.sum(hit_scores)\n    \n    # Running sum\n    running_sum = 0\n    max_es = 0\n    min_es = 0\n    max_idx = 0\n    \n    hit_set = set(hit_indices)\n    hit_ptr = 0\n    \n    running_sums = []\n    for i in range(n_genes):\n        if i in hit_set:\n            running_sum += np.abs(scores[i]) / hit_sum if hit_sum > 0 else 1/n_hit\n        else:\n            running_sum -= 1 / n_miss if n_miss > 0 else 0\n        \n        running_sums.append(running_sum)\n        \n        if running_sum > max_es:\n            max_es = running_sum\n            max_idx = i\n        if running_sum < min_es:\n            min_es = running_sum\n    \n    # ES is the maximum deviation\n    if abs(max_es) >= abs(min_es):\n        es = max_es\n        # Leading edge: hit genes up to ES peak\n        leading_edge = [idx for idx in hit_indices if idx <= max_idx]\n    else:\n        es = min_es\n        # Leading edge: hit genes after ES peak\n        leading_edge = [idx for idx in hit_indices if idx >= max_idx]\n    \n    return es, leading_edge\n\n\nprint('GSEA functions defined (NES calculation bug fixed - using np.abs)')"
