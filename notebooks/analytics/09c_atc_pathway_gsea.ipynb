   "source": "# Threshold settings\nQ_THRESHOLD = 0.05\n\ndf_sig = df_all_gsea[df_all_gsea['q_value'] < Q_THRESHOLD]\n\nif len(df_sig) > 0:\n    print(f'Significant GSEA results (q<{Q_THRESHOLD}): {len(df_sig)} records')\n    print(f'Number of ATC classes: {df_sig[\"atc_class\"].nunique()}')\n    print(f'Upregulated (NES>0): {(df_sig[\"nes\"] > 0).sum()}, Downregulated (NES<0): {(df_sig[\"nes\"] < 0).sum()}')\n    \n    # Use only significant results\n    sig_pathways = df_sig['pathway'].unique()\n    \n    # Calculate variance per pathway\n    df_pivot_sig = df_sig.pivot_table(\n        index='pathway',\n        columns='atc_class',\n        values='nes',\n        aggfunc='mean'\n    ).fillna(0)\n    \n    pathway_var = df_pivot_sig.var(axis=1).sort_values(ascending=False)\n    top_pathways = pathway_var.head(30).index.tolist()\n    \n    # Create plot data (significant results only)\n    df_plot_sig = df_sig[df_sig['pathway'].isin(top_pathways)].copy()\n    \n    # Compound count mapping per ATC class (for X-axis labels)\n    atc_compound_counts = df_plot_sig.drop_duplicates('atc_class').set_index('atc_class')['n_compounds'].to_dict()\n    \n    # Convert X-axis labels to include compound count\n    atc_classes_sorted = sorted(df_plot_sig['atc_class'].unique())\n    atc_label_map = {atc: f\"{atc} (n={atc_compound_counts.get(atc, '?')})\" for atc in atc_classes_sorted}\n    df_plot_sig['atc_label'] = df_plot_sig['atc_class'].map(atc_label_map)\n    \n    # Convert pathway names to abbreviations\n    df_plot_sig['pathway_abbr'] = df_plot_sig['pathway'].apply(abbreviate_pathway)\n    \n    # Plot\n    n_atc = df_plot_sig['atc_class'].nunique()\n    n_pathways = len(top_pathways)\n    fig, ax = plt.subplots(figsize=(max(10, n_atc * 0.6), max(8, n_pathways * 0.35)))\n    \n    # Size proportional to n_genes (gene count)\n    size_min, size_max = 30, 200\n    gene_min, gene_max = df_plot_sig['n_genes'].min(), df_plot_sig['n_genes'].max()\n    if gene_max > gene_min:\n        df_plot_sig['size'] = size_min + (df_plot_sig['n_genes'] - gene_min) / (gene_max - gene_min) * (size_max - size_min)\n    else:\n        df_plot_sig['size'] = (size_min + size_max) / 2\n    \n    # Color by NES (up=red, down=blue)\n    nes_max = df_plot_sig['nes'].abs().max()\n    \n    # Plot with atc_label (including compound count)\n    scatter = ax.scatter(\n        df_plot_sig['atc_label'],\n        df_plot_sig['pathway_abbr'],\n        c=df_plot_sig['nes'],\n        s=df_plot_sig['size'],\n        cmap='RdBu_r',\n        vmin=-nes_max,\n        vmax=nes_max,\n        edgecolors='black',\n        linewidth=0.5,\n        alpha=0.8\n    )\n    \n    plt.colorbar(scatter, ax=ax, shrink=0.5, label='NES\\n(red=up, blue=down)')\n    \n    ax.set_xlabel('ATC Class (L2)', fontweight='bold')\n    ax.set_ylabel('GlycoEnzOnto', fontweight='bold')\n    ax.set_title(f'ATC Class (L2) × GlycoEnzOnto Pathway GSEA\\n(q < {Q_THRESHOLD} only)', fontweight='bold')\n    \n    plt.xticks(rotation=60, ha='right')\n    plt.yticks(fontsize=10)\n    \n    # Size legend (gene count)\n    for n_gene in [5, 15, 30]:\n        if gene_min <= n_gene <= gene_max:\n            size = size_min + (n_gene - gene_min) / (gene_max - gene_min) * (size_max - size_min)\n            ax.scatter([], [], c='gray', s=size, label=f'{n_gene} genes', \n                      edgecolors='black', linewidth=0.5)\n    ax.legend(title='Gene count', loc='upper right', bbox_to_anchor=(1.25, 1), fontsize=8)\n    \n    plt.tight_layout()\n    \n    fig.savefig(results_dir / 'atc_L2_pathway_gsea_dotplot.png', dpi=300, bbox_inches='tight', facecolor='white')\n    fig.savefig(results_dir / 'atc_L2_pathway_gsea_dotplot.pdf', bbox_inches='tight', facecolor='white')\n    fig.savefig(results_dir / 'atc_L2_pathway_gsea_dotplot.svg', format='svg', bbox_inches='tight', facecolor='white')\n    print(f'\\nSaved: {results_dir / \"atc_L2_pathway_gsea_dotplot.png\"}')\n    \n    plt.show()\nelse:\n    print(f'No significant GSEA