        <oboInOwl:hasAlternativeId>GO:0022415</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>Wikipedia:Viral_life_cycle</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>virus process</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>viral infection</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>virulence</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>GO:0016032</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/go#goslim_metagenomics"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/go#goslim_pir"/>
        <rdfs:comment>See also the biological process terms &apos;viral infectious cycle ; GO:0019058&apos; and &apos;lysogeny ; GO:0030069&apos;.</rdfs:comment>
        <rdfs:label>viral process</rdfs:label>
