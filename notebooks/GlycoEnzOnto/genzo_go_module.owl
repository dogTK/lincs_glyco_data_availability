        <owl:annotatedTarget>programmed cell death by autophagy</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GOC:pr</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
