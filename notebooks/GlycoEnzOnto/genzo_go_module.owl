    <!-- http://purl.obolibrary.org/obo/GO_0072009 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0072009">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0072073"/>
        <rdfs:subClassOf>
            <owl:Restriction>
