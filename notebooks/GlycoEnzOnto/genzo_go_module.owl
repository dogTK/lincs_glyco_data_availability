    <!-- http://purl.obolibrary.org/obo/GO_0036126 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0036126">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0097729"/>
        <obo:IAO_0000115>A microtubule-based flagellum (or cilium) that is part of a sperm, a mature male germ cell that develops from a spermatid.</obo:IAO_0000115>
        <oboInOwl:created_by>bf</oboInOwl:created_by>
        <oboInOwl:creation_date>2012-02-28T02:39:00Z</oboInOwl:creation_date>
