        <oboInOwl:hasExactSynonym>haemopoiesis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>hematopoiesis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:id>GO:0030097</oboInOwl:id>
        <rdfs:label>hemopoiesis</rdfs:label>
    </owl:Class>
