    <!-- http://purl.obolibrary.org/obo/GO_0007254 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0007254">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0051403"/>
        <obo:IAO_0000115>An intracellular protein kinase cascade containing at least a JNK (a MAPK), a JNKK (a MAPKK) and a JUN3K (a MAP3K). The cascade can also contain an additional tier: the upstream MAP4K. The kinases in each tier phosphorylate and activate the kinases in the downstream tier to transmit a signal within a cell.</obo:IAO_0000115>
