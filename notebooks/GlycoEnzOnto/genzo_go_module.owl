    <!-- http://purl.obolibrary.org/obo/GO_0006953 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0006953">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0002526"/>
        <obo:IAO_0000115>An acute inflammatory response that involves non-antibody proteins whose concentrations in the plasma increase in response to infection or injury of homeothermic animals.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
