        <oboInOwl:hasAlternativeId>GO:0015570</oboInOwl:hasAlternativeId>
        <oboInOwl:hasBroadSynonym>active transporter</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref>Reactome:R-HSA-199216</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>TC:2.A</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>coupled carrier</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>electrochemical potential-driven transporter activity</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>porter activity</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>porters</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>secondary carrier-type facilitators</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>energizer of outer membrane receptor-mediated transport activity</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>heavy metal ion porter activity</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>ion-gradient-driven energizer activity</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>multidrug endosomal transmembrane transporter activity</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>nitrite/nitrate porter activity</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasOBONamespace>molecular_function</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>galactose/glucose (methylgalactoside) porter activity</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>GO:0015291</oboInOwl:id>
        <rdfs:label>secondary active transmembrane transporter activity</rdfs:label>
    </owl:Class>
