    <!-- http://purl.obolibrary.org/obo/GO_0051455 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0051455">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/GO_0008608"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0045143"/>
