    <!-- http://purl.obolibrary.org/obo/GO_0007605 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0007605">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0050954"/>
        <obo:IAO_0000115>The series of events required for an organism to receive an auditory stimulus, convert it to a molecular signal, and recognize and characterize the signal. Sonic stimuli are detected in the form of vibrations and are processed to form a sound.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>Wikipedia:Hearing_(sense)</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>hearing</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>perception of sound</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:id>GO:0007605</oboInOwl:id>
        <rdfs:label>sensory perception of sound</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0007605"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The series of events required for an organism to receive an auditory stimulus, convert it to a molecular signal, and recognize and characterize the signal. Sonic stimuli are detected in the form of vibrations and are processed to form a sound.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GOC:ai</oboInOwl:hasDbXref>
    </owl:Axiom>
    


