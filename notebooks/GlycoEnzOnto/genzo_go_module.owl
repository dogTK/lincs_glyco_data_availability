    <!-- http://purl.obolibrary.org/obo/GO_0044320 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0044320">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0032870"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0044321"/>
        <obo:IAO_0000115>Any process that results in a change in state or activity of a cell (in terms of movement, secretion, enzyme production, gene expression, etc.) as a result of a leptin stimulus. Leptin is a hormone manufactured primarily in the adipocytes of white adipose tissue, and the level of circulating leptin is directly proportional to the total amount of fat in the body. It plays a key role in regulating energy intake and energy expenditure, including appetite and metabolism.</obo:IAO_0000115>
        <oboInOwl:created_by>jl</oboInOwl:created_by>
        <oboInOwl:creation_date>2010-07-14T02:21:32Z</oboInOwl:creation_date>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:id>GO:0044320</oboInOwl:id>
        <rdfs:label>cellular response to leptin stimulus</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0044320"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Any process that results in a change in state or activity of a cell (in terms of movement, secretion, enzyme production, gene expression, etc.) as a result of a leptin stimulus. Leptin is a hormone manufactured primarily in the adipocytes of white adipose tissue, and the level of circulating leptin is directly proportional to the total amount of fat in the body. It plays a key role in regulating energy intake and energy expenditure, including appetite and metabolism.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GOC:yaf</oboInOwl:hasDbXref>
    </owl:Axiom>
    


