                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0019058"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The process that occurs after viral attachment by which a virus, or viral nucleic acid, breaches the plasma membrane or cell envelope and enters the host cell. The process ends when the viral nucleic acid is released into the host cell cytoplasm.</obo:IAO_0000115>
