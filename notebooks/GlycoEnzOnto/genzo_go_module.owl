        <oboInOwl:hasNarrowSynonym>MAPK10 cascade</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>MAPK8 cascade</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>MAPK9 cascade</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:id>GO:0007254</oboInOwl:id>
        <rdfs:label>JNK cascade</rdfs:label>
    </owl:Class>
    <owl:Axiom>
