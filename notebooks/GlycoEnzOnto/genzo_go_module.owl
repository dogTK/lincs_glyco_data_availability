    <!-- http://purl.obolibrary.org/obo/GO_0042552 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0042552">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0008366"/>
        <obo:IAO_0000115>The process in which myelin sheaths are formed and maintained around neurons. Oligodendrocytes in the brain and spinal cord and Schwann cells in the peripheral nervous system wrap axons with compact layers of their plasma membrane. Adjacent myelin segments are separated by a non-myelinated stretch of axon called a node of Ranvier.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>Wikipedia:Myelin</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>myelinogenesis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>GO:0042552</oboInOwl:id>
        <rdfs:label>myelination</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0042552"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The process in which myelin sheaths are formed and maintained around neurons. Oligodendrocytes in the brain and spinal cord and Schwann cells in the peripheral nervous system wrap axons with compact layers of their plasma membrane. Adjacent myelin segments are separated by a non-myelinated stretch of axon called a node of Ranvier.</owl:annotatedTarget>
