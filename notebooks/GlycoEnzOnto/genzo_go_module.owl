        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0009266"/>
        <obo:IAO_0000115>Any process that results in a change in state or activity of a cell or an organism (in terms of movement, secretion, enzyme production, gene expression, etc.) as a result of a heat stimulus, a temperature stimulus above the optimal temperature for that organism.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>GO:0006951</oboInOwl:hasAlternativeId>
        <oboInOwl:hasNarrowSynonym>response to heat shock</oboInOwl:hasNarrowSynonym>
