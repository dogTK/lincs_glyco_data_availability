        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/go#goslim_metagenomics"/>
        <rdfs:comment>Note that proteins intrinsic to membranes cannot be removed without disrupting the membrane, e.g. by detergent.</rdfs:comment>
        <rdfs:label>intrinsic component of membrane</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0031224"/>
