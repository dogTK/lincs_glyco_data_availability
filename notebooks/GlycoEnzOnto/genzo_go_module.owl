        <oboInOwl:hasRelatedSynonym>cardiac development</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>GO:0007507</oboInOwl:id>
        <rdfs:label>heart development</rdfs:label>
    </owl:Class>
