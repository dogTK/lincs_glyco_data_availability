        <oboInOwl:hasExactSynonym>focal contact</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>hemi-adherens junction</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>cellular_component</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>adhesion plaque</oboInOwl:hasRelatedSynonym>
