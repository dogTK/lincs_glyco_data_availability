        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/go#goslim_plant"/>
        <rdfs:comment>Note that this term was &apos;developmental process&apos;.</rdfs:comment>
        <rdfs:label>multicellular organism development</rdfs:label>
    </owl:Class>
    <owl:Axiom>
