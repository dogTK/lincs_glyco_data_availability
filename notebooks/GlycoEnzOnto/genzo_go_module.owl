        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0048863"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The process in which a relatively unspecialized cell acquires specialized features of a stem cell. A stem cell is a cell that retains the ability to divide and proliferate throughout life to provide progenitor cells that can differentiate into specialized cells.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>CL:0000034</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GOC:isa_complete</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/GO_0048864 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0048864">
