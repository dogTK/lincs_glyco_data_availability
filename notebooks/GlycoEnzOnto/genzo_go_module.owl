    <!-- http://purl.obolibrary.org/obo/GO_0045211 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0045211">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0097060"/>
        <rdfs:subClassOf>
            <owl:Restriction>
