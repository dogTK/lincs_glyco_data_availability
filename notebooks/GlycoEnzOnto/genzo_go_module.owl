    <!-- http://purl.obolibrary.org/obo/GO_0048863 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0048863">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0030154"/>
        <obo:IAO_0000115>The process in which a relatively unspecialized cell acquires specialized features of a stem cell. A stem cell is a cell that retains the ability to divide and proliferate throughout life to provide progenitor cells that can differentiate into specialized cells.</obo:IAO_0000115>
