    <!-- http://purl.obolibrary.org/obo/GO_0036156 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0036156">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0005858"/>
        <obo:IAO_0000115>Inner arm structure present on the outer doublet microtubules of ciliary and flagellar axonemes. The structure of inner dynein arms is complex and may vary within the axoneme. Inner dynein arms are heteromeric, comprising 8 different heavy chains and various subunits. Inner and outer dynein arms have different functions in the generation of microtubule-based motility.</obo:IAO_0000115>
        <oboInOwl:created_by>bf</oboInOwl:created_by>
        <oboInOwl:creation_date>2012-03-21T01:24:54Z</oboInOwl:creation_date>
