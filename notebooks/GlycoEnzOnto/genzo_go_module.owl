        <owl:annotatedTarget>membrane bound ribosome</owl:annotatedTarget>
        <oboInOwl:hasDbXref>NIF_Subcellular:sao1291545653</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/GO_0005844 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0005844">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_1990904"/>
        <obo:IAO_0000115>A multiribosomal structure representing a linear array of ribosomes held together by messenger RNA. They represent the active complexes in cellular protein synthesis and are able to incorporate amino acids into polypeptides both in vivo and in vitro.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>NIF_Subcellular:sao1038025871</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Polysome</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>polyribosome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>cellular_component</oboInOwl:hasOBONamespace>
        <oboInOwl:id>GO:0005844</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/go#goslim_pir"/>
        <rdfs:label>polysome</rdfs:label>
    </owl:Class>
    <owl:Axiom>
