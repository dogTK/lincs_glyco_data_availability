                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0072006"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The regionalization process in which specific areas of cell differentiation are determined along a proximal/distal axis of a nephron. The proximal/distal axis is defined by a line that runs from the center of the kidney (proximal end) outward (distal end).</obo:IAO_0000115>
        <oboInOwl:created_by>mah</oboInOwl:created_by>
        <oboInOwl:creation_date>2010-01-25T03:30:48Z</oboInOwl:creation_date>
