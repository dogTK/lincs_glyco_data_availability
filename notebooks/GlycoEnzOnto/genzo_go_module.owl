    <!-- http://purl.obolibrary.org/obo/GO_0045185 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0045185">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0051235"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0008104"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Any process in which a protein is maintained in a location and prevented from moving elsewhere. These include sequestration, stabilization to prevent transport elsewhere and the active retrieval of proteins that do move away.</obo:IAO_0000115>
