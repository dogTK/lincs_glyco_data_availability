    <!-- http://purl.obolibrary.org/obo/GO_0060113 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0060113">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0042490"/>
        <rdfs:subClassOf>
            <owl:Restriction>
