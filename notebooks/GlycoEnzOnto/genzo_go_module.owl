                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0060485"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The process in which a relatively unspecialized cell acquires specialized features of a mesenchymal cell. A mesenchymal cell is a loosely associated cell that is part of the connective tissue in an organism. Mesenchymal cells give rise to more mature connective tissue cell types.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:id>GO:0048762</oboInOwl:id>
        <rdfs:label>mesenchymal cell differentiation</rdfs:label>
    </owl:Class>
