    <!-- http://purl.obolibrary.org/obo/GO_0007416 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0007416">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0034329"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0050808"/>
