        <oboInOwl:hasDbXref>PMID:18846107</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:20823910</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:21737330</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:21760595</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:21876153</oboInOwl:hasDbXref>
