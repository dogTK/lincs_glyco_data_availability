    <!-- http://purl.obolibrary.org/obo/GO_0004714 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0004714">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0004713"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0019199"/>
