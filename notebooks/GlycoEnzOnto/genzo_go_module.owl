            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A dynein complex found in eukaryotic cilia and flagella; the motor domain heads interact with adjacent microtubules to generate a sliding force which is converted to a bending motion.</obo:IAO_0000115>
        <oboInOwl:hasNarrowSynonym>axonemal dynein heavy chain</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>axonemal dynein intermediate chain</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>axonemal dynein intermediate light chain</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>axonemal dynein light chain</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasOBONamespace>cellular_component</oboInOwl:hasOBONamespace>
        <oboInOwl:id>GO:0005858</oboInOwl:id>
        <rdfs:label>axonemal dynein complex</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0005858"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A dynein complex found in eukaryotic cilia and flagella; the motor domain heads interact with adjacent microtubules to generate a sliding force which is converted to a bending motion.</owl:annotatedTarget>
