    <!-- http://purl.obolibrary.org/obo/GO_0009855 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0009855">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0009799"/>
        <obo:IAO_0000115>The establishment of an organism&apos;s body plan or part of an organism with respect to a single longitudinal plane. The pattern can either be symmetric, such that the halves are mirror images, or asymmetric where the pattern deviates from this symmetry.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>determination of bilateral asymmetry</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
