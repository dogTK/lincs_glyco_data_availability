        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0007264"/>
        <obo:IAO_0000115>The series of molecular signals within the cell that are mediated by a member of the Ras superfamily of proteins switching to a GTP-bound active state.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Ras mediated signal transduction</oboInOwl:hasExactSynonym>
