        <oboInOwl:hasRelatedSynonym>blood pressure homeostasis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>control of blood pressure</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>GO:0008217</oboInOwl:id>
        <rdfs:label>regulation of blood pressure</rdfs:label>
