    <!-- http://purl.obolibrary.org/obo/GO_0009451 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0009451">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0016070"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0043412"/>
        <obo:IAO_0000115>The covalent alteration of one or more nucleotides within an RNA molecule to produce an RNA molecule with a sequence that differs from that coded genetically.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>GO:0016547</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>Wikipedia:RNA_editing</oboInOwl:hasDbXref>
        <oboInOwl:hasNarrowSynonym>RNA editing</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:id>GO:0009451</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/go#goslim_yeast"/>
        <rdfs:comment>The term &apos;RNA editing&apos; (GO:0016547) was merged into &apos;RNA modification&apos; (GO:0009451) on the basis of statements in the preface of Modification and Editing of RNA (ISBN:1555811337) that there is no clear distinction between modification and editing.</rdfs:comment>
        <rdfs:label>RNA modification</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0009451"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The covalent alteration of one or more nucleotides within an RNA molecule to produce an RNA molecule with a sequence that differs from that coded genetically.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GOC:go_curators</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ISBN:1555811337</oboInOwl:hasDbXref>
