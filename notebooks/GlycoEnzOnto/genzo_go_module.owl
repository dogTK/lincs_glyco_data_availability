        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/go#goslim_metagenomics"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/go#goslim_pir"/>
        <rdfs:comment>This term was intentionally placed under &apos;protein metabolic process ; GO:0019538&apos; rather than &apos;protein catabolic process ; GO:0030163&apos; to cover all processes centered on breaking peptide bonds, including those involved in protein processing.</rdfs:comment>
