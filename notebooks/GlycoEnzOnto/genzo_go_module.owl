    <!-- http://purl.obolibrary.org/obo/GO_0002931 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0002931">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0006950"/>
        <obo:IAO_0000115>Any process that results in a change in state or activity of an organism (in terms of movement, secretion, enzyme production, gene expression, etc.) as a result of a inadequate blood supply.</obo:IAO_0000115>
        <oboInOwl:created_by>hjd</oboInOwl:created_by>
        <oboInOwl:creation_date>2012-04-20T02:57:51Z</oboInOwl:creation_date>
