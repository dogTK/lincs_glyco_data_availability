        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0071711"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0085029"/>
        <obo:IAO_0000115>The aggregation, arrangement and bonding together of a set of components to form a basement membrane, a part of the extracellular region that consists of a thin layer of dense material found in various animal tissues interposed between the cells and the adjacent connective tissue.</obo:IAO_0000115>
        <oboInOwl:created_by>mah</oboInOwl:created_by>
        <oboInOwl:creation_date>2009-07-23T05:01:51Z</oboInOwl:creation_date>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:id>GO:0070831</oboInOwl:id>
        <rdfs:comment>Note that this term has no relationship to &apos;membrane assembly ; GO:0071709&apos; because the basement membrane is not a lipid bilayer.</rdfs:comment>
        <rdfs:label>basement membrane assembly</rdfs:label>
