    <!-- http://purl.obolibrary.org/obo/GO_0048730 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0048730">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0002009"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0008544"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The process in which the anatomical structures of the epidermis are generated and organized. The epidermis is the outer epithelial layer of an animal, it may be a single layer that produces an extracellular material (e.g. the cuticle of arthropods) or a complex stratified squamous epithelium, as in the case of many vertebrate species.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>hypodermis morphogenesis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>GO:0048730</oboInOwl:id>
        <rdfs:label>epidermis morphogenesis</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0048730"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The process in which the anatomical structures of the epidermis are generated and organized. The epidermis is the outer epithelial layer of an animal, it may be a single layer that produces an extracellular material (e.g. the cuticle of arthropods) or a complex stratified squamous epithelium, as in the case of many vertebrate species.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GOC:jid</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UBERON:0001003</oboInOwl:hasDbXref>
