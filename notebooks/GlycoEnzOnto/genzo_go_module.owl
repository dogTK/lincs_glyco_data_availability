        <oboInOwl:hasExactSynonym>mitochondrial protein translation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:id>GO:0032543</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/go#goslim_yeast"/>
        <rdfs:label>mitochondrial translation</rdfs:label>
    </owl:Class>
