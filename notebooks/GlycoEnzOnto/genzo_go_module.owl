        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The directed movement of glucose-6-phosphate into, out of or within a cell, or between cells, by means of some agent such as a transporter or pore. Glucose-6-phosphate is a monophosphorylated derivative of glucose with the phosphate group attached to C-6.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GOC:ai</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/GO_0015780 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0015780">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0015931"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0055085"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_1901264"/>
        <obo:IAO_0000115>The directed movement of nucleotide-sugars into, out of or within a cell, or between cells, by means of some agent such as a transporter or pore. Nucleotide-sugars are any nucleotide in which the distal phosphoric residue of a nucleoside 5&apos;-diphosphate is in glycosidic linkage with a monosaccharide or monosaccharide derivative.</obo:IAO_0000115>
