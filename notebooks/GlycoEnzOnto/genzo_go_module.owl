        <obo:IAO_0000115>The process in which a chondroblast acquires specialized structural and/or functional features of a chondrocyte. A chondrocyte is a polymorphic cell that forms cartilage.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:id>GO:0002062</oboInOwl:id>
        <rdfs:label>chondrocyte differentiation</rdfs:label>
    </owl:Class>
    <owl:Axiom>
