        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0050877"/>
        <obo:IAO_0000115>A process carried out by the nervous system that is required for the proper control of respiratory gaseous exchange. This process occurs in the respiratory center of the brain in vertebrates.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>neurological control of breathing</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>regulation of respiratory gaseous exchange by neurological system process</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:id>GO:0002087</oboInOwl:id>
        <rdfs:label>regulation of respiratory gaseous exchange by nervous system process</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0002087"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A process carried out by the nervous system that is required for the proper control of respiratory gaseous exchange. This process occurs in the respiratory center of the brain in vertebrates.</owl:annotatedTarget>
