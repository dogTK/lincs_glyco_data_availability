    <!-- http://purl.obolibrary.org/obo/GO_0048854 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0048854">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0009887"/>
        <rdfs:subClassOf>
