        <owl:annotatedTarget>protein amino acid N-linked glycosylation via asparagine</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GOC:bf</oboInOwl:hasDbXref>
