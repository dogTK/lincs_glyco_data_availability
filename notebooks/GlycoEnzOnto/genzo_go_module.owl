    <!-- http://purl.obolibrary.org/obo/GO_0030127 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0030127">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0030120"/>
        <rdfs:subClassOf>
            <owl:Restriction>
