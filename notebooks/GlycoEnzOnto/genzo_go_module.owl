        <oboInOwl:hasRelatedSynonym>Embden-Meyerhof-Parnas pathway</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>anaerobic glycolysis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>glycolysis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>modifed Embden-Meyerhof pathway</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>GO:0006096</oboInOwl:id>
        <rdfs:label>glycolytic process</rdfs:label>
