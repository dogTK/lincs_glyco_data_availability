    <!-- http://purl.obolibrary.org/obo/GO_0036465 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0036465">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0006810"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0051649"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0099504"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The trafficking of synaptic vesicles from the pre-synaptic membrane so the vesicle can dock and prime for another round of exocytosis and neurotransmitter release. Recycling occurs after synaptic vesicle exocytosis, and is necessary to replenish presynaptic vesicle pools, sustain transmitter release and preserve the structural integrity of the presynaptic membrane. Recycling can occur following transient fusion with the presynaptic membrane (kiss and run), or via endocytosis of presynaptic membrane.</obo:IAO_0000115>
        <oboInOwl:created_by>bf</oboInOwl:created_by>
        <oboInOwl:creation_date>2014-06-26T11:03:08Z</oboInOwl:creation_date>
        <oboInOwl:hasNarrowSynonym>kiss-and-run synaptic vesicle recycling</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>kiss-and-stay synaptic vesicle recycling</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:id>GO:0036465</oboInOwl:id>
        <rdfs:label>synaptic vesicle recycling</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0036465"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The trafficking of synaptic vesicles from the pre-synaptic membrane so the vesicle can dock and prime for another round of exocytosis and neurotransmitter release. Recycling occurs after synaptic vesicle exocytosis, and is necessary to replenish presynaptic vesicle pools, sustain transmitter release and preserve the structural integrity of the presynaptic membrane. Recycling can occur following transient fusion with the presynaptic membrane (kiss and run), or via endocytosis of presynaptic membrane.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GOC:PARL</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GOC:bf</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GOC:pad</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:15217342</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:22026965</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:23245563</oboInOwl:hasDbXref>
    </owl:Axiom>
