                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0043010"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The process in which the anatomical structures of the eye are generated and organized. The camera-type eye is an organ of sight that receives light through an aperture and focuses it through a lens, projecting it on a photoreceptor field.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>GO:0048594</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>GO:0048595</oboInOwl:hasAlternativeId>
