    <!-- http://purl.obolibrary.org/obo/GO_0036499 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0036499">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0006984"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0030968"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0140467"/>
        <obo:IAO_0000115>The series of molecular signals mediated by the endoplasmic reticulum membrane stress sensor PERK (PKR-like ER kinase). Begins with activation of PERK in response to endoplasmic reticulum (ER) stress and ends with regulation of a downstream cellular process, e.g. transcription. The main substrate of PERK is the translation initiation factor eIF2alpha. Serine-phosphorylation of eIF2alpha by PERK inactivates eIF2alpha and inhibits general protein translation. In addition, eIF2alpha phosphorylation preferentially increases the translation of selective mRNAs such as ATF4 (activating transcription factor 4), which up regulates a subset of UPR genes required to restore folding capacity.</obo:IAO_0000115>
        <oboInOwl:created_by>bf</oboInOwl:created_by>
        <oboInOwl:creation_date>2015-02-05T13:17:43Z</oboInOwl:creation_date>
        <oboInOwl:hasBroadSynonym>PERK signal transduction pathway</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasExactSynonym>PERK branch of UPR</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>PKR-like ER kinase signal transduction</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>UPR signaling by PERK stress sensor</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>endoplasmic reticulum unfolded protein response; PERK signaling</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>EIF2AK3-mediated unfolded protein response</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>PERK signaling in response to endoplasmic reticulum stress</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>eukaryotic translation initiation factor 2-alpha kinase 3-mediated unfolded protein response</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>GO:0036499</oboInOwl:id>
        <rdfs:label>PERK-mediated unfolded protein response</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0036499"/>
