    <!-- http://purl.obolibrary.org/obo/GO_0007600 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0007600">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0050877"/>
        <obo:IAO_0000115>The series of events required for an organism to receive a sensory stimulus, convert it to a molecular signal, and recognize and characterize the signal. This is a neurological process.</obo:IAO_0000115>
