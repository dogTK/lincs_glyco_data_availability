                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0006888"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Any process that modulates the rate, frequency, or extent of ER to Golgi vesicle-mediated transport, the directed movement of substances from the endoplasmic reticulum (ER) to the Golgi, mediated by COP II vesicles. Small COP II coated vesicles form from the ER and then fuse directly with the cis-Golgi. Larger structures are transported along microtubules to the cis-Golgi.</obo:IAO_0000115>
        <oboInOwl:created_by>dph</oboInOwl:created_by>
        <oboInOwl:creation_date>2009-05-18T02:37:00Z</oboInOwl:creation_date>
