    <!-- http://purl.obolibrary.org/obo/GO_0009055 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0009055">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/GO_0016491"/>
                    <owl:Restriction>
