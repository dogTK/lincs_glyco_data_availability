    <!-- http://purl.obolibrary.org/obo/GO_0070293 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0070293">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0003014"/>
        <obo:IAO_0000115>A renal system process in which water, ions, glucose and proteins are taken up from the collecting ducts, glomerulus and proximal and distal loops of the nephron. In non-mammalian species, absorption may occur in related structures (e.g. protein absorption is observed in nephrocytes in Drosophila, see PMID:23264686).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>nephron absorption</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>renal reabsorption</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:id>GO:0070293</oboInOwl:id>
        <rdfs:label>renal absorption</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0070293"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A renal system process in which water, ions, glucose and proteins are taken up from the collecting ducts, glomerulus and proximal and distal loops of the nephron. In non-mammalian species, absorption may occur in related structures (e.g. protein absorption is observed in nephrocytes in Drosophila, see PMID:23264686).</owl:annotatedTarget>
