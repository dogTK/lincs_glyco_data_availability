                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0034975"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Any process that modulates the rate, frequency or extent of the protein folding process that takes place in the endoplasmic reticulum (ER). Secreted, plasma membrane and organelle proteins are folded in the ER, assisted by chaperones and foldases (protein disulphide isomerases), and additional factors required for optimal folding (ATP, Ca2+ and an oxidizing environment to allow disulfide bond formation).</obo:IAO_0000115>
        <oboInOwl:created_by>dph</oboInOwl:created_by>
        <oboInOwl:creation_date>2009-08-14T01:12:00Z</oboInOwl:creation_date>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:id>GO:0060904</oboInOwl:id>
        <rdfs:label>regulation of protein folding in endoplasmic reticulum</rdfs:label>
    </owl:Class>
