        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0030182"/>
        <obo:IAO_0000115>The process in which a neuroblast or one of its progeny commits to a pyramidal neuron fate, migrates from the ventricular zone to the appropriate layer in the cortex and develops into a mature neuron.</obo:IAO_0000115>
        <oboInOwl:hasBroadSynonym>projection neuron differentiation</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:id>GO:0021859</oboInOwl:id>
        <rdfs:label>pyramidal neuron differentiation</rdfs:label>
    </owl:Class>
