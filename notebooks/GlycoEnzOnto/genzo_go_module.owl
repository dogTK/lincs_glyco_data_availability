        <oboInOwl:hasExactSynonym>heparan sulphate proteoglycan biosynthesis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>heparan sulphate proteoglycan biosynthetic process</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
