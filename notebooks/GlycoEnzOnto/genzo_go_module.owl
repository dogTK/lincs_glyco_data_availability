    <!-- http://purl.obolibrary.org/obo/GO_0007369 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0007369">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0048598"/>
        <rdfs:subClassOf>
