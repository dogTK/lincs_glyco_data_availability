        <oboInOwl:id>GO:0002931</oboInOwl:id>
        <rdfs:comment>Ischemia always results in hypoxia; however, hypoxia can occur without ischemia.</rdfs:comment>
        <rdfs:label>response to ischemia</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0002931"/>
