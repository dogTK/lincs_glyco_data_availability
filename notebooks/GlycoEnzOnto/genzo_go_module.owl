    <!-- http://purl.obolibrary.org/obo/GO_0038024 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0038024">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0003674"/>
