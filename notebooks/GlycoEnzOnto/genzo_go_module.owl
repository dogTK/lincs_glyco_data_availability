    <!-- http://purl.obolibrary.org/obo/GO_0038061 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0038061">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0035556"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0051092"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The process in which a signal is passed on to downstream components within the cell through the NIK-dependent processing and activation of NF-KappaB. Begins with activation of the NF-KappaB-inducing kinase (NIK), which in turn phosphorylates and activates IkappaB kinase alpha (IKKalpha). IKKalpha phosphorylates the NF-Kappa B2 protein (p100) leading to p100 processing and release of an active NF-KappaB (p52).</obo:IAO_0000115>
        <obo:IAO_0000233 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://github.com/geneontology/go-ontology/pull/22958</obo:IAO_0000233>
        <oboInOwl:created_by>bf</oboInOwl:created_by>
        <oboInOwl:creation_date>2012-01-16T05:44:46Z</oboInOwl:creation_date>
        <oboInOwl:hasBroadSynonym>non-canonical NF-KB signaling</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>noncanonical NF-kappaB signaling</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>noncanonical nuclear factor kappaB (NF-kappaB) pathway</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasExactSynonym>NIK/NF-kappaB signal transduction</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>p52-dependent NF-kappaB signaling</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>NIK-IKK cascade</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NIK-IKK kinase cascade</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NIK-IKK signaling pathway</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NIK-IKK-alpha cascade</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NIK/NF-kappaB cascade</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>GO:0038061</oboInOwl:id>
        <rdfs:label>NIK/NF-kappaB signaling</rdfs:label>
    </owl:Class>
