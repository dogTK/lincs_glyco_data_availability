    <!-- http://purl.obolibrary.org/obo/GO_0021772 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0021772">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0048856"/>
