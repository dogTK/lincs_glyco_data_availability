    <!-- http://purl.obolibrary.org/obo/GO_0043686 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0043686">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0036211"/>
        <obo:IAO_0000115>The process of covalently altering one or more amino acids in a protein after translation has begun but before the protein has been released from the ribosome.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>co-translational amino acid modification</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>co-translational modification</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>cotranslational amino acid modification</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>cotranslational modification</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>cotranslational protein modification</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:id>GO:0043686</oboInOwl:id>
        <rdfs:comment>This term should only be used to annotate a protein modification process that occurs after the start of translation but while the protein is still on the ribosome.</rdfs:comment>
        <rdfs:label>co-translational protein modification</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0043686"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The process of covalently altering one or more amino acids in a protein after translation has begun but before the protein has been released from the ribosome.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GOC:jsg</oboInOwl:hasDbXref>
