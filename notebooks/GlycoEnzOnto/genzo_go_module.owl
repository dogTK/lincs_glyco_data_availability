        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An intracellular structure that can catalyze gamma-tubulin-dependent microtubule nucleation and that can anchor microtubules by interacting with their minus ends, plus ends or sides.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GOC:vw</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ISBN:0815316194</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:17072892</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:17245416</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Microtubule_organizing_center</oboInOwl:hasDbXref>
    </owl:Axiom>
    


