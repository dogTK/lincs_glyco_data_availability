        <oboInOwl:hasBroadSynonym>stress-activated protein kinase cascade</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasExactSynonym>c-Jun N-terminal kinase cascade</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>JNK1 cascade</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>JNK2 cascade</oboInOwl:hasNarrowSynonym>
