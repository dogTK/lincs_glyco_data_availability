                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0140013"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Progression through the phases of the meiotic cell cycle, in which canonically a cell replicates to produce four offspring with half the chromosomal content of the progenitor cell via two nuclear divisions.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>GO:0007126</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>Wikipedia:Meiosis</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
