    <!-- http://purl.obolibrary.org/obo/GO_0031175 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0031175">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/GO_0120036"/>
