    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0007492">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0009888"/>
        <obo:IAO_0000115>The process whose specific outcome is the progression of the endoderm over time, from its formation to the mature structure. The endoderm is the innermost germ layer that develops into the gastrointestinal tract, the lungs and associated tissues.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:id>GO:0007492</oboInOwl:id>
