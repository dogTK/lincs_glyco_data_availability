        <oboInOwl:hasExactSynonym>cellular response to endoplasmic reticulum stress</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>response to ER stress</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:id>GO:0034976</oboInOwl:id>
        <rdfs:label>response to endoplasmic reticulum stress</rdfs:label>
    </owl:Class>
