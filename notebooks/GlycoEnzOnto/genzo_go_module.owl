                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0007338"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The binding and fusion of a sperm, with the plasma membrane of the oocyte as part of the process of single fertilization. In sperm with flagella, binding occurs at the posterior (post-acrosomal) region of the sperm head.</obo:IAO_0000115>
        <oboInOwl:hasNarrowSynonym>sperm-oocyte fusion</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:id>GO:0007342</oboInOwl:id>
        <rdfs:label>fusion of sperm to egg plasma membrane involved in single fertilization</rdfs:label>
    </owl:Class>
