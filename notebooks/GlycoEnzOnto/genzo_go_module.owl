        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GOC:jl</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>http://arbl.cvmbs.colostate.edu/hbooks/pathphys/reprod/fert/fert.html</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/GO_0007342 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0007342">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0022412"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0045026"/>
        <rdfs:subClassOf>
            <owl:Restriction>
