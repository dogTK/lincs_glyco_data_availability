    <!-- http://purl.obolibrary.org/obo/GO_0060428 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0060428">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0060429"/>
